set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C5T144C8
set_global_assignment -name TOP_LEVEL_ENTITY cyclone2_lcd_ml_hw
set_global_assignment -name SYSTEMVERILOG_FILE cyclone2_lcd_ml_hw.sv
set_global_assignment -name SYSTEMVERILOG_FILE experiments/touch_ml_scanpipe_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE touch_capture_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE xpt2046_reader.sv
set_global_assignment -name SYSTEMVERILOG_FILE xpt2046_calibrator.sv
set_global_assignment -name SYSTEMVERILOG_FILE touch_frame_adapter.sv
set_global_assignment -name SYSTEMVERILOG_FILE experiments/ml_inference_scanpipe.sv
set_global_assignment -name SDC_FILE cyclone2_lcd_ml_hw.sdc
set_global_assignment -name MIF_FILE ../artifacts/weights_l1.mif
set_global_assignment -name MIF_FILE ../artifacts/weights_l2.mif
set_global_assignment -name MIF_FILE ../artifacts/bias_l1.mif
set_global_assignment -name MIF_FILE ../artifacts/bias_l2.mif
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 13.0
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_hw
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"

set_location_assignment PIN_17  -to clk50
set_location_assignment PIN_88  -to reset_n
set_location_assignment PIN_139 -to joystick_up_n
set_location_assignment PIN_143 -to joystick_down_n
set_location_assignment PIN_129 -to touch_irq_n
set_location_assignment PIN_135 -to touch_miso
set_location_assignment PIN_134 -to touch_cs_n
set_location_assignment PIN_133 -to touch_sclk
set_location_assignment PIN_136 -to touch_mosi
set_location_assignment PIN_8   -to led[0]
set_location_assignment PIN_9   -to led[1]
set_location_assignment PIN_24  -to led[2]
set_location_assignment PIN_25  -to led[3]
set_location_assignment PIN_4   -to buzzer_n

set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to joystick_up_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to joystick_down_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to touch_irq_n
